# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# published articles: the publisher versions are not ours to redistribute
*.pdf
# ...but the manual is ours, and is meant to be shipped with the program
!docs/CMF_manual.pdf

# saved models, predictions and run logs
*.cmf
*.log
predictions*.csv
scores*.csv
*.cube

# editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# ORCA scratch (inputs, outputs, wavefunctions) written by the quantum-property runs
orca_work/
benchmarks/results/corrosion_qm/*/orca/
benchmarks/results/am_eu/orca/

# xtb scratch of the cheap quantum stage: one job directory per molecule, 233 MB for the
# whole collection. The annotated results are in the .json files, which are kept.
benchmarks/results/xtb/work/

# the trajectories benchmarks/run_trajectory.py writes for itself, rebuilt by one command
benchmarks/results/trajectory/work/

# the simulations behind examples/md: 1.3 GB of trajectories and prepared structures.
# The ensemble SDFs they are read into are kept, and the script rebuilds the rest.
examples/md/work/

# build artefacts of the package
build/
dist/
*.whl

# kernels cached by benchmarks/kernel_cache.py
benchmarks/cache/

# UMA adsorption runs: per-pose relaxation logs, geometries and records (the SDF and CSV are kept)
examples/corrosion_fe110/*_work/

# ORCA scratch of the quantum-property runs on the UMA poses
examples/corrosion_fe110/*_orca/

# the LIT-PCBA archive is 57 MB and is not ours to redistribute: the maker downloads it
examples/litpcba/*.tgz

# the artefacts of a reader's own run of the case studies (the benchmark keeps the numbers)
examples/case_studies/

# the HTML API reference is built, not committed (python -m sphinx -b html docs/sphinx docs/sphinx/_build/html)
docs/sphinx/_build/
docs/sphinx/_autosummary/

# Jupyter's autosaves next to the tutorial notebooks
.ipynb_checkpoints/

# the distribution the ether set is built from states no licence: the maker fetches it
examples/ether/upstream/

# the conductivity table the electrolyte set is derived from: the maker fetches it
examples/electrolyte/upstream/

# the phenazine redox table and geometries of item EC1: the maker fetches them, and the
# distributor states no licence, so no copy is kept here
examples/phenazine/upstream/

# the ORCA scratch directory of the phenazine quantum stage (1.8 GB of .gbw and .densities
# files): the maker rebuilds it, and the annotated SDF beside it is what the benchmark reads
examples/phenazine/qm_work/

# the source files of the two metal-complex series (plan item EC4): the maker downloads them
# again with --fetch, and the built SDF beside them is what the benchmark reads
examples/complexes_fe/upstream/
examples/complexes_ni/upstream/
